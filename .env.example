# GlucoAI Environment Configuration
# Copy this file to .env and fill in your values

# ── Database ──
DATABASE_URL=sqlite:///./glucoai.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/glucoai

# ── AI / LLM ──
# Get your free key at https://console.groq.com/
GROQ_API_KEY=

# ── API Security (production) ──
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY=optional-api-key-for-route-protection

# ── Application ──
ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000
